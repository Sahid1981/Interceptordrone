{
    "version": "2.0.0",
    "tasks": [
        {
            "label": "Build C++ Drone Controller",
            "type": "shell",
            "command": "g++",
            "args": [
                "-std=c++17",
                "-o",
                "${workspaceFolder}/Cpp/build/drone_controller",
                "${workspaceFolder}/Cpp/src/main.cpp",
                "-lstdc++"
            ],
            "group": {
                "kind": "build",
                "isDefault": false
            },
            "problemMatcher": [
                "$gcc"
            ]
        },
        {
            "label": "Run YOLO Test",
            "type": "shell",
            "command": "python",
            "args": [
                "${workspaceFolder}/Python/yolo_test.py"
            ],
            "group": "test"
        },
        {
            "type": "cppbuild",
            "label": "C/C++: cl.exe build active file",
            "command": "cl.exe",
            "args": [
                "/Zi",
                "/EHsc",
                "/nologo",
                "/Fe${fileDirname}\\${fileBasenameNoExtension}.exe",
                "${file}"
            ],
            "options": {
                "cwd": "${fileDirname}"
            },
            "problemMatcher": [
                "$msCompile"
            ],
            "group": {
                "kind": "build",
                "isDefault": true
            },
            "detail": "Task generated by Debugger."
        }
    ]
}